{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_READING_ENDPOINT": "https://lamp-reading.lamp-reading-server.workers.dev"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_READING_ENDPOINT": "https://lamp-reading.lamp-reading-server.workers.dev"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
